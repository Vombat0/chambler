# Chambler server configuration (copy to `.env`; never commit real secrets).
# Loaded with `tsx --env-file=.env` or your process manager.

# HTTP + WebSocket port (0 = random, useful in tests).
PORT=3001
# Bind interface.
HOST=0.0.0.0

# Comma-separated browser origins allowed to call /health and /api, and to
# open a WebSocket. `*` allows every origin (development only).
CORS_ORIGINS=http://localhost:5173

# Players per table (1-8).
MAX_PLAYERS=8
# Seat kept for a dropped player, in seconds (full reconnect flow: B4).
RECONNECTION_SECONDS=30

# Chat limits.
CHAT_MAX_LENGTH=300
CHAT_RATE_LIMIT=3
CHAT_RATE_WINDOW_MS=1000

# Largest accepted WebSocket frame, in bytes.
MAX_PAYLOAD_BYTES=16384
