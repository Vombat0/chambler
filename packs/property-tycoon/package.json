{
  "name": "@chambler/pack-property-tycoon",
  "version": "0.1.0",
  "private": true,
  "description": "Mülk Tycoon — the reference game pack for Chambler: 40 cells, 8 districts, 32 cards, code-generated art.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "art": "tsx scripts/generate-art.ts",
    "manifest": "tsx scripts/build-manifest.ts",
    "build": "pnpm run art && pnpm run manifest",
    "validate": "node ../../packages/modkit/dist/cli.js .",
    "test": "vitest run",
    "test:local": "node ../../packages/modkit/node_modules/vitest/vitest.mjs run",
    "art:local": "node ../../packages/modkit/node_modules/.bin/tsx scripts/generate-art.ts",
    "manifest:local": "node ../../packages/modkit/node_modules/.bin/tsx scripts/build-manifest.ts"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "vitest": "^3.2.7"
  }
}
