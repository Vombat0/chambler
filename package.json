{
  "name": "chambler",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-based, online multiplayer tabletop simulator (monorepo).",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msgpackr-extract"
    ]
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
